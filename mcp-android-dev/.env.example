# ============================================================
# BYO Android Dev MCP Server — Windows Environment Variables
# Copy this file to .env and fill in your actual paths.
# NEVER commit your .env file to source control.
# ============================================================

# ------------------------------------------------------------
# Android SDK root (default Windows location shown)
# If using D: drive install, use D:\android-sdk
# ------------------------------------------------------------
ANDROID_SDK_ROOT=D:\android-sdk

# Convenience aliases (both are accepted by Android tooling)
ANDROID_HOME=D:\android-sdk

# ------------------------------------------------------------
# Java home — Android Studio Bundled JBR (JDK 17)
# Typical Android Studio install location on Windows:
#   C:\Program Files\Android\Android Studio\jbr
# Or if Android Studio is on D: drive:
#   D:\Android Studio\jbr
# ------------------------------------------------------------
JAVA_HOME=C:\Program Files\Android\Android Studio\jbr

# ------------------------------------------------------------
# Android project workspace root on Windows
# Set this to the directory containing your build.gradle / settings.gradle
# ------------------------------------------------------------
ANDROID_PROJECT_ROOT=D:\agent-lee-voxel-os\agent-lee-android

# ------------------------------------------------------------
# ADB executable path (auto-resolved from ANDROID_SDK_ROOT if omitted)
# Default: %ANDROID_SDK_ROOT%\platform-tools\adb.exe
# ------------------------------------------------------------
# ADB_PATH=D:\android-sdk\platform-tools\adb.exe

# ------------------------------------------------------------
# Gradle wrapper path (relative to project root, or absolute)
# Usually just "gradlew.bat" inside the project root on Windows
# ------------------------------------------------------------
# GRADLE_WRAPPER=gradlew.bat

# ------------------------------------------------------------
# Optional: Build timeout in milliseconds (default: 300000 = 5 min)
# ------------------------------------------------------------
# BUILD_TIMEOUT_MS=300000

# ------------------------------------------------------------
# Optional: ADB command timeout in milliseconds (default: 30000 = 30 s)
# ------------------------------------------------------------
# ADB_TIMEOUT_MS=30000

# ------------------------------------------------------------
# MCP server transport (stdio | http)
# Use "stdio" when connecting via VS Code / Copilot Chat extension
# ------------------------------------------------------------
MCP_TRANSPORT=stdio

# ------------------------------------------------------------
# Logging level: debug | info | warn | error (default: info)
# ------------------------------------------------------------
LOG_LEVEL=info
