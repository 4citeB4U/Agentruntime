# Paths to Android SDK and build tools (override config file values via env)
ANDROID_SDK_ROOT=/path/to/Android/sdk
ANDROID_HOME=/path/to/Android/sdk
JAVA_HOME=/path/to/java

# Keystore credentials — NEVER commit these values
KEYSTORE_STORE_PASSWORD=
KEYSTORE_KEY_PASSWORD=

# Optional: absolute path to your android-dev-mcp config file
# Defaults to android-dev-mcp.config.json in the current working directory
ANDROID_MCP_CONFIG=/path/to/android-dev-mcp.config.json
